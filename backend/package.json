{
  "name": "unime-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the Unime Power BI Semantic Model",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsc -p tsconfig.test.json --noEmit && tsx --test src/config/cors.node-test.ts src/routes/dax.route.node-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.2",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
