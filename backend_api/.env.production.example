# ──────────────────────────────────────────────────────────────────────
# Production environment variables — cho tất cả hosting providers
# ──────────────────────────────────────────────────────────────────────
# Copy nội dung file này vào Railway Variables tab hoặc Render Dashboard
# (hoặc dùng CLI nếu supported)
#
# KHÔNG commit file .env thật lên Git — chỉ dùng local hoặc paste vào dashboard.
# ──────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3000

# Microsoft Entra ID (App Registration)
# → Lấy từ portal.azure.com → App Registrations → ứng dụng của bạn
TENANT_ID=<your-tenant-guid>
CLIENT_ID=<your-client-guid>
CLIENT_SECRET=<paste-actual-secret-here-on-dashboard-only>

# Fabric semantic model
# → Lấy từ URL trong Fabric portal: groups/{WORKSPACE_ID}/models/{SEMANTIC_MODEL_ID}
WORKSPACE_ID=<your-workspace-guid>
SEMANTIC_MODEL_ID=<your-semantic-model-guid>

# Optional
DAX_MAX_LENGTH_BYTES=512000
