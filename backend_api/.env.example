# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Microsoft Entra ID (Azure AD) ──────────────────────────────────────────
# Service Principal dùng để authenticate với Power BI / Fabric.
# Tạo trong: portal.azure.com → App Registrations → New registration.
# Sau đó tạo Client Secret trong "Certificates & secrets".
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret-here

# ─── Fabric semantic model ───────────────────────────────────────────────────
# Lấy từ URL của semantic model trong Fabric portal:
# https://app.fabric.microsoft.com/groups/{WORKSPACE_ID}/models/{SEMANTIC_MODEL_ID}
WORKSPACE_ID=00000000-0000-0000-0000-000000000000
SEMANTIC_MODEL_ID=00000000-0000-0000-0000-000000000000

# ─── Request limits ──────────────────────────────────────────────────────────
# Max kích thước DAX query (bytes). Power BI REST giới hạn 15MB/query, để mặc định 500KB là an toàn.
DAX_MAX_LENGTH_BYTES=512000
