{
  "name": "unime-chat-data-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated data service for the Unime chatbot",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:capabilities": "node scripts/generate-query-capabilities.mjs",
    "predev": "npm run generate:capabilities",
    "dev": "tsx watch src/server.ts",
    "pretypecheck": "npm run generate:capabilities",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run generate:capabilities",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "prebuild": "npm run generate:capabilities",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.27.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
