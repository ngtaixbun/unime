NODE_ENV=development
PORT=3101
# Bind address. Loopback only outside production; Render uses 0.0.0.0.
CHAT_HOST=127.0.0.1
# Development/test only. Use a long, random server-side value; never expose it via VITE_*.
CHAT_DATA_API_TEST_CREDENTIAL=
CHAT_SEMANTIC_ENABLED=false

# Production inbound authentication (Hubi backend -> Chat Data API).
# Keep these identities separate from the Power BI service principal below.
CHAT_ENTRA_TENANT_ID=
CHAT_ENTRA_API_AUDIENCE=
CHAT_ENTRA_ALLOWED_CLIENT_IDS=
CHAT_ENTRA_CLOCK_TOLERANCE_SECONDS=30
CHAT_ENTRA_MAX_TOKEN_AGE_SECONDS=3600
CHAT_ENTRA_JWKS_CACHE_MS=600000
CHAT_ENTRA_JWKS_COOLDOWN_MS=30000
CHAT_ENTRA_JWKS_TIMEOUT_MS=5000

# Process-local operational safeguards. Multi-instance deployments require a
# shared gateway/store for aggregate rate and concurrency enforcement.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=60
CHAT_RATE_LIMIT_MAX_CLIENTS=10000
CHAT_SEMANTIC_MAX_CONCURRENCY=4
CHAT_SEMANTIC_MAX_QUEUE=16
CHAT_SEMANTIC_QUEUE_TIMEOUT_MS=5000
CHAT_REQUEST_TIMEOUT_MS=65000
CHAT_MAX_RESPONSE_BYTES=16384
# Production must set this to true and terminate HTTPS at a trusted ingress.
CHAT_REQUIRE_HTTPS=false
CHAT_TRUST_PROXY_HOPS=0

# STEP 02 local development only. Copy existing approved service-principal values locally.
# Never commit real values and never expose them as VITE_* variables.
CHAT_POWERBI_TENANT_ID=
CHAT_POWERBI_CLIENT_ID=
CHAT_POWERBI_CLIENT_SECRET=
CHAT_POWERBI_WORKSPACE_ID=
CHAT_POWERBI_SEMANTIC_MODEL_ID=
CHAT_POWERBI_TIMEOUT_MS=60000
CHAT_POWERBI_MAX_RESPONSE_BYTES=262144
