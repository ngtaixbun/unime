DEFINE
    VAR _SelectedCycleKey =
        __SELECTED_CYCLE_KEY__

    VAR _SelectedKpiId =
        __SELECTED_KPI_ID__

EVALUATE
VAR _Rows =
    CALCULATETABLE(
        SELECTCOLUMNS(
            SUMMARIZECOLUMNS(
                'dimnv'[Employee_Id],
                'dimnv'[FullName],
                'dimnv'[Region ID],
                'dimnv'[amm_id],
                'dimnv'[sup_id],

                "actual",
                    [Actual KPI Selected],

                "target",
                    [Target KPI Selected],

                "percentage",
                    [MTD KPI Selected]
            ),

            "employeeId",
                'dimnv'[Employee_Id],

            "employeeLabel",
                'dimnv'[FullName],

            "regionId",
                'dimnv'[Region ID],

            "ammId",
                'dimnv'[amm_id],

            "supervisorId",
                'dimnv'[sup_id],

            "actual",
                [actual],

            "target",
                [target],

            "percentage",
                [percentage]
        ),

        KEEPFILTERS(
            TREATAS(
                { _SelectedCycleKey },
                'Date'[Chu kỳ KPI Key]
            )
        ),

        KEEPFILTERS(
            TREATAS(
                { _SelectedKpiId },
                'KPIname'[num]
            )
        )

        __REGION_FILTER__
        __AMM_FILTER__
        __SUPERVISOR_FILTER__
    )

RETURN
FILTER(
    _Rows,

    NOT ISBLANK([employeeId])
        && NOT ISBLANK([employeeLabel])
)

ORDER BY
    [percentage] ASC,
    [employeeLabel] ASC,
    [employeeId] ASC
