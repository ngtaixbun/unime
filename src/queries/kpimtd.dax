
DEFINE
    VAR _SelectedCycleKey =
        __SELECTED_CYCLE_KEY__

EVALUATE
CALCULATETABLE(
    ROW(
        "successfulCallsMtd",
            [mtd_call] * 100,

        "successfulCallsIssued",
            [nvfail_call],

        "visitMtd",
            [mtd_visit] * 100,

        "visitIssued",
            [nvfail_visit],

        "timeSpendMtd",
            [mtd_timespend] * 100,

        "timeSpendIssued",
            [nvfail_timespend],

        "osaMtd",
            [mtd_osa] * 100,

        "osaIssued",
            [nvfail_osa],

        "qcMtd",
            [mtd_qc] * 100,

        "qcIssued",
            [nvfail_qc]
    ),

    KEEPFILTERS(
        TREATAS(
            { _SelectedCycleKey },
            'Date'[Chu kỳ KPI Key]
        )
    )
    __REGION_FILTER__
    __AMM_FILTER__
    __SUPERVISOR_FILTER__
)
